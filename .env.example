# Grant environment variables. Copy to `.env.local`; never commit real keys.

# Local development: http://localhost:3000
# Production deployment: https://grant-md.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Encryption for OAuth and encrypted OpenRouter keys.
GRANT_ENCRYPTION_SECRET=
GRANT_ENCRYPTION_SECRET_PREVIOUS=
GRANT_CSRF_SECRET=
GRANT_HEALTH_SECRET=

# OpenRouter models used with each user's own encrypted OpenRouter key.
ANALYSIS_MODEL=
TAB_MODEL=
PANEL_MODEL=

# Transactional email for company invitations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Grant <hello@example.com>

# GitHub OAuth for Markdown sync.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional public contact links. Blank values hide the corresponding link.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/devndesigner6/grant
# Optional JSON status endpoint for the marketing status badge.
GRANT_STATUS_URL=

MEDIAN_API_KEY=
# Set to 0 only when deliberately using report-only CSP during a controlled rollout.
# GRANT_CSP_ENFORCE=1
# ANALYZE=true
# NEXT_PUBLIC_RELEASE_SHA=
