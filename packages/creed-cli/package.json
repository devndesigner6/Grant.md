{
  "name": "@devndesigner/grant-cli",
  "version": "0.2.3",
  "description": "The first-party terminal client for Grant.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "grant": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "grant",
    "mcp",
    "cli",
    "context",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devndesigner6/grant.git",
    "directory": "packages/creed-cli"
  },
  "homepage": "https://github.com/devndesigner6/grant",
  "bugs": "https://github.com/devndesigner6/grant/issues"
}
